# Copiar a .env y completar localmente. Nunca incorporar secretos a Git.
DRY_RUN=true
FIREBASE_DATABASE_URL=https://unidad4-aiot-cava-default-rtdb.firebaseio.com
# Ruta absoluta o relativa a 03_supervisor_aiot/.
FIREBASE_CREDENTIALS_PATH=credentials/firebase-service-account.json
FIREBASE_TIMEOUT_SECONDS=10

GEMINI_API_KEY=
# auto lista los modelos de la key y prefiere Flash-Lite estable con generateContent.
# La compatibilidad estructurada se comprueba al validar la primera respuesta.
GEMINI_MODEL=auto
GEMINI_TIMEOUT_SECONDS=20
GEMINI_MIN_INTERVAL_SECONDS=60
GEMINI_CACHE_SECONDS=300
GEMINI_RETRY_SECONDS=120
GEMINI_RETRY_MAX_SECONDS=900

RECOVERY_STABLE_SECONDS=60
MAX_MEASUREMENT_AGE_SECONDS=20
MAX_SAMPLE_GAP_SECONDS=15
FUTURE_TOLERANCE_SECONDS=5
SUPERVISOR_PUBLISH_SECONDS=60
LISTENER_RETRY_SECONDS=5

# Requerido para POST /evaluar. Generar con secrets.token_urlsafe(32).
LOCAL_API_TOKEN=
# Una sola instancia en este equipo. Por defecto .runtime/supervisor.lock.
SUPERVISOR_LOCK_FILE=.runtime/supervisor.lock
